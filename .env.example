APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_USERNAME=sail
DB_PASSWORD=password
DB_DATABASE=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Reverb server binds inside the reverb container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# The PHP app publishes events to the reverb container over the Sail network.
REVERB_APP_ID=111322
REVERB_APP_KEY=249b1654427e725d4b2e755ad358a641
REVERB_APP_SECRET=ae87ccd8c352b3eecf42968d1e6a8b3a
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# The browser connects to the port the reverb container exposes on the host.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
QUEUE_CONNECTION=database

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Host the browser loads Vite dev-server assets from. Leave as localhost for
# normal local dev. To open the app from another device on your network, set
# this to this machine's LAN IP (e.g. 192.168.1.187) and restart `npm run dev`.
#VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_HOST=192.168.1.187

# Dev-mode SSR: lets the Sail container reach the Vite dev server on the host.
# Remove (or leave unset) in production — the built SSR server is used there.
INERTIA_SSR_HOT_URL=http://host.docker.internal:5174
